# .env.example — 비밀 값의 변수 이름만 적는다. 실제 값은 같은 폴더의 .env(Git 제외)에 쓴다.
#   cp .env.example .env    (Windows: copy .env.example .env)
#
# 현재 유료 생성(힉스필드)·Google Drive는 Claude 커넥터 로그인으로 연결하므로 API 키가 필요 없다.
# 아래 값은 에이전트가 생성 요청을 만들 때 읽는다. 문서·로그에 값을 쓰지 않는다.

# 나레이션 보이스 (힉스필드 elevenlabs_v4)
NARRATION_VOICE_NAME=
NARRATION_VOICE_ELEMENT_ID=

# (선택) ElevenLabs를 직접 쓸 때
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_KEY=

# (선택) 커넥터 대신 API로 직접 호출할 때
HIGGSFIELD_API_KEY=
