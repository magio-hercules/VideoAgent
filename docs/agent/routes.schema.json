{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoAgent doc-router routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limits", "forbidden_default", "representative_tags", "routes"],
  "$defs": {
    "tag": { "type": "string", "pattern": "^[^\\s,]{1,40}$" },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "routeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "uniqueTags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "uniqueItems": true, "minItems": 1 },
    "uniquePaths": { "type": "array", "items": { "$ref": "#/$defs/relpath" }, "uniqueItems": true },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "$ref": "#/$defs/uniqueTags" },
        "path_globs": { "allOf": [{ "$ref": "#/$defs/uniquePaths" }, { "minItems": 1 }] }
      },
      "anyOf": [{ "required": ["tags"] }, { "required": ["path_globs"] }]
    },
    "conditional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "when"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/match" },
        "read_order": { "allOf": [{ "$ref": "#/$defs/uniquePaths" }, { "minItems": 1 }] },
        "nearest": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/\\\\]+\\.md$" }
        }
      },
      "anyOf": [{ "required": ["read_order"] }, { "required": ["nearest"] }]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "match", "read_order", "conditional_docs"],
      "properties": {
        "id": { "$ref": "#/$defs/routeId" },
        "description": { "type": "string", "minLength": 1 },
        "match": { "$ref": "#/$defs/match" },
        "read_order": { "$ref": "#/$defs/uniquePaths" },
        "conditional_docs": { "type": "array", "items": { "$ref": "#/$defs/conditional" } }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_agent_max_bytes", "initial_route_max_bytes", "initial_route_warning_ratio"],
      "properties": {
        "root_agent_max_bytes": { "type": "integer", "minimum": 1, "maximum": 12288 },
        "initial_route_max_bytes": { "type": "integer", "minimum": 1 },
        "initial_route_warning_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "forbidden_default": { "allOf": [{ "$ref": "#/$defs/uniquePaths" }, { "minItems": 1 }] },
    "representative_tags": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/tag" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/routeId" }
      }
    },
    "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } }
  }
}
